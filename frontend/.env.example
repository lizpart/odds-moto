# Frontend Configuration Template

# Copy this file to .env and fill in your credentials

# ===== PAYSTACK PAYMENT GATEWAY =====
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# ===== WHATSAPP CONFIGURATION =====
# Using whatsapp-web.js library (Selenium-based)
# No API keys needed - authenticate via QR code
# Will migrate to Twilio once WhatsApp number is verified
WHATSAPP_SESSION_DIR=./data/whatsapp_sessions
WHATSAPP_WEBHOOK_TOKEN=football_predictions_token

# Future Twilio Configuration (after number verification)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===== TELEGRAM CONFIGURATION =====
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook

# ===== BACKEND API =====
FOOTBALL_API_BASE=http://localhost:8000

# ===== SERVER CONFIGURATION =====
# WhatsApp Bot Server
WHATSAPP_SERVER_HOST=0.0.0.0
WHATSAPP_SERVER_PORT=5000

# Telegram Bot Server
TELEGRAM_SERVER_HOST=0.0.0.0
TELEGRAM_SERVER_PORT=5001

# ===== DATA STORAGE =====
DATA_DIR=data
CACHE_DIR=cache

# ===== LOGGING =====
LOG_LEVEL=INFO
